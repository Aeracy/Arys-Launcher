                            <StackPanel x:Name="ImportSourcePanel" Margin="0,18,0,0">
                                <TextBlock Text="{local:Text ChooseLocalPackFile}" Style="{StaticResource MutedText}" />
                                <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox x:Name="ArchivePathText" IsReadOnly="True" FontSize="11" /><Button x:Name="ChooseArchiveButton" Grid.Column="1" Content="{local:Text ChooseFile}" Margin="9,0,0,0" Click="ChooseArchive_Click" /></Grid>
                            </StackPanel>
                            <TextBlock x:Name="ImportSummary" Text="{local:Text PackDetailsAfterSelection}" Style="{StaticResource MutedText}" Margin="0,16,0,0" />
                            <TextBlock Text="{local:Text ModpackName}" Style="{StaticResource FieldLabel}" /><TextBox x:Name="ImportNameText" />
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{local:Text MinecraftVersion}" Style="{StaticResource FieldLabel}" /><TextBox x:Name="ImportMinecraftText" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="{local:Text ForgeVersion}" Style="{StaticResource FieldLabel}" /><TextBox x:Name="ImportForgeText" /></StackPanel></Grid>
                            <TextBlock Text="{local:Text ImportLoaderVersionHelp}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,10,0,0" />
                            <TextBlock x:Name="ImportErrorText" Foreground="#F0A6BD" TextWrapping="Wrap" Margin="0,13,0,0" Visibility="Collapsed" />
                            <Button x:Name="CommitImportButton" Content="{local:Text StartImport}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Margin="0,22,0,0" MinWidth="130" Click="CommitImport_Click" IsEnabled="False" />
                        </StackPanel>
                    </local:SmoothScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
