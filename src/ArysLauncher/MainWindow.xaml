<Window x:Class="ArysLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ArysLauncher"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Arys Launcher" Width="1320" Height="860" MinWidth="1080" MinHeight="730"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}" FontFamily="{StaticResource UiFont}" FontSize="13"
        Icon="Assets/app.png"
        Language="{x:Static local:LauncherText.Language}" TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True" SnapsToDevicePixels="True" AllowDrop="True"
        DragOver="Window_DragOver" Drop="Window_Drop" PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing" Loaded="Window_Loaded">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="52" ResizeBorderThickness="7" GlassFrameThickness="0" CornerRadius="12" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="NavItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="NavSurface" Background="Transparent" CornerRadius="9">
                            <Grid>
                                <Border x:Name="SelectionTint" Background="#392941" CornerRadius="9" Opacity="0" IsHitTestVisible="False" />
                                <Border x:Name="Indicator" Width="3" Height="20" Background="{StaticResource AccentGradient}"
                                        HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="1.5" Opacity="0" />
                                <ContentPresenter Margin="{TemplateBinding Padding}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavSurface" Property="Background" Value="#2A2033" /></Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="SelectionTint" Property="Opacity" Value="1" />
                                <Setter TargetName="Indicator" Property="Opacity" Value="1" />
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions><Condition Property="IsSelected" Value="True" /><Condition Property="local:LauncherMotion.ReducedMotion" Value="False" /></MultiTrigger.Conditions>
                                <MultiTrigger.EnterActions>
                                    <BeginStoryboard x:Name="SelectFade">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="SelectionTint" Storyboard.TargetProperty="Opacity"
                                                             From="0.25" To="1" Duration="0:0:0.18" FillBehavior="Stop" />
                                            <DoubleAnimation Storyboard.TargetName="Indicator" Storyboard.TargetProperty="Opacity"
                                                             From="0.25" To="1" Duration="0:0:0.22" FillBehavior="Stop" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </MultiTrigger.EnterActions>
                                <MultiTrigger.ExitActions><RemoveStoryboard BeginStoryboardName="SelectFade" /></MultiTrigger.ExitActions>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NavIcon" TargetType="Path">
            <Setter Property="Width" Value="17" />
            <Setter Property="Height" Value="17" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
            <Setter Property="StrokeThickness" Value="1.4" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
        </Style>
        <Style x:Key="ChromeIcon" TargetType="Path">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            <Setter Property="StrokeThickness" Value="1.3" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
        </Style>
        <Style x:Key="WorkPercentage" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="MinWidth" Value="46" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
            <Setter Property="Text" Value="{Binding WorkProgressValue, RelativeSource={RelativeSource AncestorType=local:MainWindow}, StringFormat={}{0:0}%}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsWorkIndeterminate, RelativeSource={RelativeSource AncestorType=local:MainWindow}}" Value="True">
                    <Setter Property="Text" Value="{local:Text Working}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CardListItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemSurface" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="13" Padding="18,14">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemSurface" Property="BorderBrush" Value="#72517E" /></Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemSurface" Property="BorderBrush" Value="#C199BB" />
                                <Setter TargetName="ItemSurface" Property="Background" Value="#251A2D" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border x:Name="WindowSurface" Background="{StaticResource ShellBrush}" BorderBrush="{StaticResource GlassEdgeBrush}"
            BorderThickness="1" CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="*" />
                <RowDefinition Height="30" />
            </Grid.RowDefinitions>
            <local:AtmosphereView x:Name="WindowAtmosphere" Grid.RowSpan="3" IsBackdrop="True"
                                  IsHitTestVisible="False" ClipToBounds="True" />
            <Border Grid.Row="0" Background="#A016101D" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" CornerRadius="12,12,0,0">
                <Grid Margin="17,0,11,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="31" Height="31" CornerRadius="9" Background="#30223B" BorderBrush="#5B4367" BorderThickness="1">
                            <Image Source="Assets/app.png" Stretch="UniformToFill">
                                <Image.Clip>
                                    <RectangleGeometry Rect="0,0,29,29" RadiusX="8" RadiusY="8" />
                                </Image.Clip>
                            </Image>
                        </Border>
                        <TextBlock Text="ARYS" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" Margin="11,0,0,0" />
                        <TextBlock Text="LAUNCHER" Style="{StaticResource Caption}" FontSize="10" VerticalAlignment="Center" Margin="8,2,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource ChromeButton}" Click="Minimize_Click" ToolTip="{local:Text Minimize}" AutomationProperties.Name="{local:Text Minimize}">
                            <Path Style="{StaticResource ChromeIcon}" Data="M 1,6 L 11,6" />
                        </Button>
                        <Button Style="{StaticResource ChromeButton}" Click="Maximize_Click" ToolTip="{local:Text MaximizeOrRestore}" AutomationProperties.Name="{local:Text MaximizeOrRestore}">
                            <Path Style="{StaticResource ChromeIcon}" Data="M 2,2 H 10 V 10 H 2 Z" />
                        </Button>
                        <Button Style="{StaticResource CloseChromeButton}" Click="Close_Click" ToolTip="{local:Text Close}" AutomationProperties.Name="{local:Text Close}">
                            <Path Style="{StaticResource ChromeIcon}" Data="M 2,2 L 10,10 M 10,2 L 2,10" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                    <Grid Margin="15,26,15,20">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock Text="{local:Text GameAndSettings}" Style="{StaticResource Caption}" Margin="13,0,0,14" />
                        <ListBox x:Name="Navigation" Grid.Row="1" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource NavItem}"
                                 SelectionChanged="Navigation_SelectionChanged" SelectedIndex="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBoxItem Tag="home" AutomationProperties.Name="{local:Text Home}">
                                <StackPanel Orientation="Horizontal"><Path Style="{StaticResource NavIcon}" Data="M 2,8 L 9,2 L 16,8 V 16 H 11 V 11 H 7 V 16 H 2 Z" /><TextBlock Text="{local:Text Home}" VerticalAlignment="Center" /></StackPanel>
                            </ListBoxItem>
                            <ListBoxItem Tag="instances" AutomationProperties.Name="{local:Text Modpack}">
                                <StackPanel Orientation="Horizontal"><Path Style="{StaticResource NavIcon}" Data="M 9,1 L 16,5 V 13 L 9,17 L 2,13 V 5 Z M 2,5 L 9,9 L 16,5 M 9,9 V 17 M 5.5,3 L 12.5,7" /><TextBlock Text="{local:Text Modpack}" VerticalAlignment="Center" /></StackPanel>
                            </ListBoxItem>
                            <ListBoxItem Tag="accounts" AutomationProperties.Name="{local:Text Accounts}">
                                <StackPanel Orientation="Horizontal"><Path Style="{StaticResource NavIcon}" Data="M 9,2 A 3.2,3.2 0 1 1 8.99,2 M 2,16 V 14 C 2,9 16,9 16,14 V 16 Z" /><TextBlock Text="{local:Text Accounts}" VerticalAlignment="Center" /></StackPanel>
                            </ListBoxItem>
                            <ListBoxItem Tag="tasks" AutomationProperties.Name="{local:Text Downloads}">
                                <StackPanel Orientation="Horizontal"><Path Style="{StaticResource NavIcon}" Data="M 9,2 V 12 M 5,8 L 9,12 L 13,8 M 2,12 V 16 H 16 V 12" /><TextBlock Text="{local:Text Downloads}" VerticalAlignment="Center" /></StackPanel>
                            </ListBoxItem>
                            <ListBoxItem Tag="settings" AutomationProperties.Name="{local:Text Settings}">
                                <StackPanel Orientation="Horizontal"><Path Style="{StaticResource NavIcon}" Data="M 2,4 H 7 M 11,4 H 16 M 7,2 V 6 M 2,9 H 11 M 15,9 H 16 M 11,7 V 11 M 2,14 H 5 M 9,14 H 16 M 5,12 V 16" /><TextBlock Text="{local:Text Settings}" VerticalAlignment="Center" /></StackPanel>
                            </ListBoxItem>
                        </ListBox>
                        <Button Grid.Row="2" Content="{local:Text LauncherDirectoryLink}" Style="{StaticResource QuietButton}" HorizontalAlignment="Stretch"
                                Margin="0,14,0,0" Padding="11,8" Click="OpenLauncherDirectory_Click" />
                    </Grid>
                </Border>
                <Grid Grid.Column="1" Margin="30,23,28,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="87" /></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,18,16">
                            <TextBlock x:Name="PageTitle" Text="{local:Text HomePageTitle}" FontSize="27" FontWeight="SemiBold" />
                            <TextBlock x:Name="PageSubtitle" Text="{local:Text HomePageDescription}" Style="{StaticResource MutedText}" Margin="0,5,0,0" />
                        </StackPanel>
                        <Button x:Name="HeaderImportButton" Grid.Column="1" Content="{local:Text ImportModpack}" VerticalAlignment="Top" Click="Import_Click" Margin="0,4,0,0" />
                    </Grid>
                    <Grid x:Name="PageViewport" Grid.Row="1" ClipToBounds="True">
                        <local:SmoothScrollViewer x:Name="HomePage">
                            <Grid Margin="0,2,4,18">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="17" /><ColumnDefinition Width="246" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <Border Height="322" CornerRadius="16" BorderBrush="#70516F" BorderThickness="1" Background="#21172A">
                                        <Grid ClipToBounds="True">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="57*" /><ColumnDefinition Width="43*" /></Grid.ColumnDefinitions>
                                            <Border Grid.ColumnSpan="2" CornerRadius="15" RenderOptions.BitmapScalingMode="HighQuality">
                                                <Border.Background><ImageBrush ImageSource="Assets/hero.png" Stretch="UniformToFill" Viewbox="0,0.12,1,0.62" /></Border.Background>
                                            </Border>
                                            <Border Grid.ColumnSpan="2" CornerRadius="15">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                                        <GradientStop Color="#F515101F" Offset="0" />
                                                        <GradientStop Color="#CF23172E" Offset="0.44" />
                                                        <GradientStop Color="#1C24152E" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>
                                            <Border Grid.ColumnSpan="2" VerticalAlignment="Bottom" Height="128" CornerRadius="0,0,15,15">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Color="#00140E1C" Offset="0" />
                                                        <GradientStop Color="#D9140E1C" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>
                                            <local:AtmosphereView x:Name="Atmosphere" Grid.Column="1" Margin="0,16,13,16"
                                                                  IsHitTestVisible="False" ClipToBounds="True" />
                                            <StackPanel VerticalAlignment="Center" Margin="30,0,0,0">
                                                <Border Style="{StaticResource Badge}" Background="#A3332439" BorderBrush="#816378"
                                                        HorizontalAlignment="Left" Margin="0,0,0,16">
                                                    <TextBlock Text="{local:Text OfficialModpack}" Style="{StaticResource Caption}" Foreground="{StaticResource GoldBrush}" />
                                                </Border>
                                                <TextBlock Text="{local:Text OfficialPackBanner}" FontFamily="Microsoft YaHei UI" FontSize="37" FontWeight="SemiBold" LineHeight="49" />
                                                <TextBlock Text="{local:Text HomeMotto}" Style="{StaticResource MutedText}" Foreground="#E8CFDF" Margin="0,9,0,0" />
                                                <StackPanel Orientation="Horizontal" Margin="0,19,0,0">
                                                    <Border Style="{StaticResource Badge}" Background="#8432233E"><TextBlock Text="Minecraft 1.20.1" FontSize="10" /></Border>
                                                    <Border Style="{StaticResource Badge}" Background="#8432233E" Margin="7,0,0,0"><TextBlock Text="Forge" FontSize="10" /></Border>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource Card}" Margin="0,16,0,0" MinHeight="118" AllowDrop="True">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,15,0">
                                                <TextBlock x:Name="HomeInstanceHeading" Text="{local:Text InstallModpack}" FontSize="16" FontWeight="SemiBold" />
                                                <TextBlock x:Name="HomeInstanceDescription" Text="{local:Text ChoosePackDescription}" Style="{StaticResource MutedText}" Margin="0,6,0,0" />
                                                <TextBlock x:Name="HomeInstanceDetails" Text="{local:Text SupportedPackFormats}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,4,0,0" />
                                            </StackPanel>
                                            <Button x:Name="HomeInstanceButton" Grid.Column="1" Content="{local:Text BrowseFilesLink}" VerticalAlignment="Center" Click="HomeInstance_Click" Padding="14,10" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                                <StackPanel x:Name="HomeSidebar" Grid.Column="2">
                                    <Border Style="{StaticResource Card}" Padding="20">
                                        <StackPanel>
                                            <TextBlock Text="{local:Text CurrentAccount}" Style="{StaticResource Caption}" />
                                            <Grid Margin="0,14,0,12">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                <Border Width="43" Height="43" Background="#3A2A46" BorderBrush="#73577D" BorderThickness="1" CornerRadius="11">
                                                    <Grid>
                                                        <TextBlock x:Name="AccountInitial" Text="◇" Foreground="{StaticResource AccentBrush}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        <Image x:Name="AccountPortraitImage" Stretch="UniformToFill" Visibility="Collapsed"
                                                               AutomationProperties.Name="{local:Text CurrentAccountAvatar}">
                                                            <Image.Clip>
                                                                <RectangleGeometry Rect="0,0,41,41" RadiusX="10" RadiusY="10" />
                                                            </Image.Clip>
                                                        </Image>
                                                    </Grid>
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock x:Name="HomeAccountName" Text="{local:Text SignedOut}" Foreground="White"
                                                               FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock x:Name="HomeAccountKind" Text="{local:Text SignInToPlay}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Grid>
                                            <Button x:Name="HomeAccountButton" Content="{local:Text AddAccountLink}" MinHeight="32" Padding="12,5" Click="Accounts_Click" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Card}" Margin="0,15,0,0" Padding="20">
                                        <StackPanel>
                                            <TextBlock Text="{local:Text RuntimeSettings}" Style="{StaticResource Caption}" Margin="0,0,0,15" />
                                            <Grid Margin="0,0,0,12"><TextBlock Text="{local:Text MemoryLimit}" Foreground="{StaticResource MutedBrush}" /><TextBlock x:Name="HomeMemory" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="{StaticResource GoldBrush}" /></Grid>
                                            <Grid><TextBlock Text="Java" Foreground="{StaticResource MutedBrush}" /><TextBlock x:Name="HomeJava" Text="{local:Text Automatic}" HorizontalAlignment="Right" /></Grid>
                                            <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,14,0,10" />
                                            <Button Content="{local:Text RuntimeSettingsLink}" Style="{StaticResource QuietButton}" MinHeight="30" Padding="11,4" Click="Settings_Click" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </local:SmoothScrollViewer>
                        <local:SmoothScrollViewer x:Name="InstallationPage" Visibility="Collapsed">
                            <StackPanel Margin="0,2,0,20">
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock x:Name="InstallationHeading" Text="{local:Text OfficialModpack}" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock x:Name="InstallationSummary" Text="{local:Text PackNotInstalled}" Style="{StaticResource MutedText}" Margin="0,12,0,0" />
                                        <Border Height="1" Background="#3C2946" Margin="0,23,0,20" />
                                        <TextBlock Text="{local:Text InstallLocation}" Foreground="#AB93B9" FontSize="11" />
                                        <TextBox x:Name="InstallationPath" IsReadOnly="True" Background="Transparent" BorderThickness="0" Padding="0,12" TextWrapping="Wrap" FontSize="12" />
                                        <Grid Margin="0,15,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <WrapPanel VerticalAlignment="Bottom" Margin="0,0,16,0">
                                                <Button Content="{local:Text OpenGameFolderLink}" Click="OpenInstance_Click" Margin="0,0,10,0" />
                                                <Button Content="{local:Text ModpackSettings}" Click="EditInstance_Click" />
                                            </WrapPanel>
                                            <StackPanel Grid.Column="1" HorizontalAlignment="Right" MaxWidth="240">
                                                <TextBlock x:Name="InstallationUpdateStatus" Text="{local:Text CompareReleaseAndLocalFiles}"
                                                           Style="{StaticResource MutedText}" FontSize="11" TextAlignment="Right"
                                                           Margin="0,0,0,9" TextWrapping="Wrap" />
                                                <Button x:Name="CheckPackUpdatesButton" Content="{local:Text CheckForUpdates}"
                                                        HorizontalAlignment="Right" MinWidth="120" Click="CheckPackUpdates_Click" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                                    <StackPanel><TextBlock Text="{local:Text InstallAndResources}" Style="{StaticResource SectionTitle}" /><TextBlock Text="{local:Text InstallationResourcesHelp}" Style="{StaticResource MutedText}" /><Button Content="{local:Text PrepareGameFiles}" HorizontalAlignment="Left" Margin="0,17,0,0" Click="Prepare_Click" /></StackPanel>
                                </Border>
                            </StackPanel>
                        </local:SmoothScrollViewer>
                        <local:SmoothScrollViewer x:Name="AccountsPage" Visibility="Collapsed">
                            <StackPanel Margin="0,2,0,20">
                                <ListBox x:Name="AccountList" Background="Transparent" BorderThickness="0" MaxHeight="200" ItemContainerStyle="{StaticResource CardListItem}" SelectionChanged="AccountList_SelectionChanged">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <StackPanel Margin="0,0,15,0">
                                                    <DockPanel>
                                                        <Path DockPanel.Dock="Left" Data="M 5,0.8 L 9.2,5 L 5,9.2 L 0.8,5 Z"
                                                              Stroke="{StaticResource GoldBrush}" StrokeThickness="1.3" Width="10" Height="10"
                                                              VerticalAlignment="Center" Margin="0,0,8,0" IsHitTestVisible="False" />
                                                        <TextBlock Text="{Binding PlayerName}" Foreground="White" FontSize="16"
                                                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding PlayerName}" />
                                                    </DockPanel>
                                                    <TextBlock Text="{Binding Description}" Style="{StaticResource MutedText}" Margin="18,5,0,0" />
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="{local:Text RemoveThisAccount}" VerticalAlignment="Center" Click="RemoveAccount_Click" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <Border Style="{StaticResource Card}" Margin="0,4,0,18">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,20,0">
                                            <TextBlock Text="{local:Text MicrosoftJavaSignIn}" Style="{StaticResource SectionTitle}" Margin="0,0,0,7" />
                                            <TextBlock Text="{local:Text MicrosoftJavaSignInHelp}" Style="{StaticResource MutedText}" />
                                        </StackPanel>
                                        <Button x:Name="MicrosoftLoginButton" Grid.Column="1" Content="{local:Text SignInWithMicrosoft}"
                                                Style="{StaticResource PrimaryButton}" VerticalAlignment="Center" Click="MicrosoftLogin_Click" />
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,9">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="{local:Text ServerAuthentication}" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" />
                                            <Button Grid.Column="1" Content="{local:Text UseLittleSkinSettings}" Padding="12,6" MinHeight="32" Click="LittleSkin_Click" />
                                        </Grid>
                                        <TextBlock Text="{local:Text ServerAuthenticationHelp}" Style="{StaticResource MutedText}" />
                                        <TextBlock Text="{local:Text SignInMethod}" Style="{StaticResource FieldLabel}" />
                                        <ComboBox x:Name="AuthenticationPresetCombo" SelectionChanged="AuthenticationPreset_SelectionChanged"><ComboBoxItem Content="LittleSkin" /><ComboBoxItem Content="{local:Text CustomYggdrasilServer}" /></ComboBox>
                                        <TextBlock Text="{local:Text AuthenticationApiUrl}" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="ExternalServerText" TextChanged="ExternalAddress_TextChanged" ToolTip="{local:Text AuthenticationApiExample}" />
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <StackPanel><TextBlock Text="{local:Text AuthenticationServerName}" Style="{StaticResource FieldLabel}" /><TextBox x:Name="ExternalServerNameText" /></StackPanel>
                                            <StackPanel Grid.Column="2"><TextBlock Text="{local:Text RegistrationLink}" Style="{StaticResource FieldLabel}" /><TextBox x:Name="ExternalRegistrationText" /></StackPanel>
                                        </Grid>
                                        <TextBlock Text="{local:Text AutoJoinServerOptional}" Style="{StaticResource FieldLabel}" /><TextBox x:Name="JoinServerText" ToolTip="{local:Text AutoJoinServerHelp}" />
                                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0"><Button Content="{local:Text SaveAuthenticationSettings}" Click="SaveAuthentication_Click" Margin="0,0,9,0" /><Button x:Name="RegisterExternalButton" Content="{local:Text RegisterAccountLink}" Style="{StaticResource QuietButton}" Click="RegisterExternal_Click" /></StackPanel>
                                        <Border Height="1" Background="#3D2C46" Margin="0,20,0,3" />
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <StackPanel><TextBlock Text="{local:Text UsernameOrEmail}" Style="{StaticResource FieldLabel}" /><TextBox x:Name="ExternalUsernameText" /></StackPanel>
                                            <StackPanel Grid.Column="2"><TextBlock Text="{local:Text Password}" Style="{StaticResource FieldLabel}" /><PasswordBox x:Name="ExternalPasswordBox" /></StackPanel>
                                        </Grid>
