<Window x:Class="ArysLauncher.ProfileImageEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ArysLauncher"
        Width="800" Height="650" MinWidth="540" MinHeight="470" WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" Icon="Assets/app.png" KeyDown="Editor_KeyDown">
    <Grid x:Name="EditorSurface" Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,18">
            <TextBlock x:Name="Heading" FontSize="23" FontWeight="SemiBold" />
            <TextBlock Text="{local:Text ProfileCropHelp}" Style="{StaticResource MutedText}" Margin="0,8,0,0" />
        </StackPanel>
        <Border Grid.Row="1" Background="#100C18" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="1">
            <Grid x:Name="Viewport" ClipToBounds="True" Background="Transparent" Cursor="SizeAll" Focusable="True" SizeChanged="Viewport_SizeChanged"
                  MouseLeftButtonDown="Viewport_Down" MouseLeftButtonUp="Viewport_Up" MouseMove="Viewport_Move" MouseWheel="Viewport_Wheel" LostMouseCapture="Viewport_LostCapture">
                <Canvas><Image x:Name="SourceImage" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality" IsHitTestVisible="False" /></Canvas>
                <Path x:Name="CropShade" Fill="#B80B0712" IsHitTestVisible="False" />
                <Canvas IsHitTestVisible="False">
                    <Border x:Name="CropFrame" BorderBrush="{StaticResource AccentBrush}" BorderThickness="2" CornerRadius="1" />
                </Canvas>
            </Grid>
        </Border>
        <Grid Grid.Row="2" Margin="0,17,0,17">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="{local:Text ProfileZoom}" VerticalAlignment="Center" Margin="0,0,14,0" />
            <Slider x:Name="ZoomSlider" Grid.Column="1" Minimum="1" Maximum="6" Value="1" ValueChanged="Zoom_Changed"
                    AutomationProperties.Name="{local:Text ProfileZoom}" VerticalAlignment="Center" />
            <Button Grid.Column="2" Content="{local:Text ProfileCenterCrop}" Margin="14,0,0,0" Click="Center_Click" />
        </Grid>
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock x:Name="CropDetails" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,16,0" />
            <Button Grid.Column="1" Content="{local:Text Cancel}" IsCancel="True" Margin="0,0,10,0" />
            <Button Grid.Column="2" Content="{local:Text ProfileApplyCrop}" Style="{StaticResource PrimaryButton}" Click="Apply_Click" />
        </Grid>
    </Grid>
</Window>
