<Window x:Class="ArysLauncher.MicrosoftLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ArysLauncher"
        xmlns:web="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="{local:Text MicrosoftSignInWindowTitle}" Icon="Assets/app.png" Width="560" Height="740" MinWidth="480" MinHeight="600"
        WindowStartupLocation="CenterOwner" Background="{StaticResource ShellBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        Language="{x:Static local:LauncherText.Language}"
        Loaded="Window_Loaded" Closed="Window_Closed">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="82" /><RowDefinition Height="*" /><RowDefinition Height="57" /></Grid.RowDefinitions>
        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="22,15">
            <StackPanel>
                <TextBlock Text="{local:Text MicrosoftAccountAuthorization}" FontSize="18" FontWeight="SemiBold" />
                <TextBlock x:Name="OriginText" Text="https://login.live.com" Style="{StaticResource Caption}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Border>
        <Grid x:Name="BrowserHost" Grid.Row="1">
            <web:WebView2CompositionControl x:Name="Browser" DefaultBackgroundColor="White" IsHitTestVisible="False" />
            <Border x:Name="LoadingPanel" Background="{StaticResource ShellBrush}" Padding="26">
                <Border x:Name="LoginMessage" Style="{StaticResource Card}" Padding="25" VerticalAlignment="Center" MaxWidth="454">
                    <StackPanel>
                        <TextBlock x:Name="LoadingTitle" Text="{local:Text OpeningMicrosoftPage}" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock x:Name="LoadingDetail" Text="{local:Text MicrosoftAuthorizationInWindow}" Style="{StaticResource MutedText}" Margin="0,11,0,0" />
                        <ProgressBar x:Name="LoginActivity" IsIndeterminate="True" Height="5" Margin="0,19,0,0"
                                     AutomationProperties.Name="{local:Text ConnectingToMicrosoft}" />
                        <Button x:Name="RetryButton" Content="{local:Text RetryMicrosoftPage}" Style="{StaticResource PrimaryButton}"
                                Visibility="Collapsed" HorizontalAlignment="Left" Margin="0,17,0,0" Click="Retry_Click" />
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
        <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="19,9">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock x:Name="LoginStatusText" Text="{local:Text MicrosoftPageProvider}" Style="{StaticResource Caption}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" />
                <Button Grid.Column="1" Content="{local:Text Cancel}" MinHeight="30" Padding="16,5" Click="Cancel_Click" />
            </Grid>
        </Border>
    </Grid>
</Window>
