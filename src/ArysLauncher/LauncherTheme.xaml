<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:ArysLauncher">
    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Microsoft YaHei UI, Segoe UI</FontFamily>
    <SolidColorBrush x:Key="BackgroundBrush" Color="#121018" />
    <SolidColorBrush x:Key="PanelBrush" Color="#211927" />
    <SolidColorBrush x:Key="BorderBrush" Color="#3C3047" />
    <SolidColorBrush x:Key="TextBrush" Color="#F5EDF7" />
    <SolidColorBrush x:Key="MutedBrush" Color="#B6A6C1" />
    <SolidColorBrush x:Key="AccentBrush" Color="#EDBFD9" />
    <SolidColorBrush x:Key="GoldBrush" Color="#E6CCA3" />
    <SolidColorBrush x:Key="FocusBrush" Color="#DFB5DC" />
    <SolidColorBrush x:Key="InputBrush" Color="#16111D" />
    <SolidColorBrush x:Key="HoverBrush" Color="#372840" />
    <SolidColorBrush x:Key="TrackBrush" Color="#382B43" />
    <LinearGradientBrush x:Key="ShellBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2A1D34" Offset="0" />
        <GradientStop Color="#16121E" Offset="0.52" />
        <GradientStop Color="#201628" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AcrylicTintBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#D62A1932" Offset="0" />
        <GradientStop Color="#C415111D" Offset="0.52" />
        <GradientStop Color="#CF251931" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassEdgeBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#AF80668E" Offset="0" />
        <GradientStop Color="#80584663" Offset="0.48" />
        <GradientStop Color="#B3634A70" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SidebarBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#A31B1425" Offset="0" />
        <GradientStop Color="#C014101B" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CardBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#E32A2033" Offset="0" />
        <GradientStop Color="#E21D1627" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="MemorySystemBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#B39CC9" Offset="0" />
        <GradientStop Color="#846B9D" Offset="0.65" />
        <GradientStop Color="#745A8D" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="MemoryGameBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFE2ED" Offset="0" />
        <GradientStop Color="#EDBEDD" Offset="0.42" />
        <GradientStop Color="#C29EDF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="MemoryPressureBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFE4BA" Offset="0" />
        <GradientStop Color="#DCA674" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="MemoryReserveBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#4E3D60" Offset="0" />
        <GradientStop Color="#30243E" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0.1" EndPoint="1,0.9">
        <GradientStop Color="#F4CBDC" Offset="0" />
        <GradientStop Color="#D3B3ED" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="WaitGradient" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#00D7ADDF" Offset="0" />
        <GradientStop Color="#00D7ADDF" Offset="0.22" />
        <GradientStop Color="#E6BBDF" Offset="0.5" />
        <GradientStop Color="#00D7ADDF" Offset="0.78" />
        <GradientStop Color="#00D7ADDF" Offset="1" />
    </LinearGradientBrush>

    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    </Style>
    <Style x:Key="MutedText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="21" />
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,14" />
    </Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="Foreground" Value="#D4C5DF" />
        <Setter Property="Margin" Value="0,12,0,7" />
    </Style>
    <Style x:Key="Caption" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="Badge" TargetType="Border">
        <Setter Property="Background" Value="#38283F" />
        <Setter Property="BorderBrush" Value="#604866" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Padding" Value="9,4" />
    </Style>
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="22" />
    </Style>
    <Style x:Key="KeyboardFocus" TargetType="Control">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Control">
                    <Border Margin="-3" CornerRadius="10" BorderThickness="1" BorderBrush="{StaticResource FocusBrush}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Background" Value="#2B2134" />
        <Setter Property="BorderBrush" Value="#4D3C59" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9">
                        <Grid>
                            <Border x:Name="HoverTint" CornerRadius="8" Background="#24F4CBE3" Opacity="0" IsHitTestVisible="False" />
                            <Border x:Name="PressTint" CornerRadius="8" Background="#2908000F" Opacity="0" IsHitTestVisible="False" />
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center"
                                              VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="BorderBrush" Value="#937198" />
                            <Setter TargetName="HoverTint" Property="Opacity" Value="1" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="local:LauncherMotion.ReducedMotion" Value="False" />
                            </MultiTrigger.Conditions>
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard x:Name="HoverFade">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverTint" Storyboard.TargetProperty="Opacity"
                                                         From="0" To="1" Duration="0:0:0.15" FillBehavior="Stop" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions><RemoveStoryboard BeginStoryboardName="HoverFade" /></MultiTrigger.ExitActions>
                        </MultiTrigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="PressTint" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Surface" Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource AccentGradient}" />
        <Setter Property="Foreground" Value="#2B1B32" />
        <Setter Property="BorderBrush" Value="#F7D5E9" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="LaunchActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Foreground" Value="#FFF3FC" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Height" Value="50" />
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#4C315E" Offset="0" />
                    <GradientStop Color="#38264B" Offset="0.55" />
                    <GradientStop Color="#271C3B" Offset="1" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="BorderBrush">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#BB977D" Offset="0" />
                    <GradientStop Color="#9876A8" Offset="0.44" />
                    <GradientStop Color="#755C93" Offset="1" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="LaunchSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="11">
                        <Grid ClipToBounds="True">
                            <Border x:Name="LaunchAura" CornerRadius="10" IsHitTestVisible="False" Opacity="0.62">
                                <Border.Background>
                                    <RadialGradientBrush Center="0.19,0.92" GradientOrigin="0.14,0.92" RadiusX="0.88" RadiusY="1.12">
                                        <GradientStop Color="#80B77BDC" Offset="0" />
                                        <GradientStop Color="#4D9965BC" Offset="0.52" />
                                        <GradientStop Color="#008F64B7" Offset="1" />
                                    </RadialGradientBrush>
                                </Border.Background>
                            </Border>
                            <Rectangle x:Name="ArcaneRim" RadiusX="10" RadiusY="10" StrokeThickness="1.25" Margin="1"
                                       IsHitTestVisible="False">
                                <Rectangle.Stroke>
                                    <LinearGradientBrush StartPoint="0,0.15" EndPoint="1,0.85">
                                        <LinearGradientBrush.RelativeTransform>
                                            <RotateTransform Angle="25" CenterX="0.5" CenterY="0.5" />
                                        </LinearGradientBrush.RelativeTransform>
                                        <GradientStop Color="#00F2CEEA" Offset="0" />
                                        <GradientStop Color="#00F2CEEA" Offset="0.54" />
                                        <GradientStop Color="#70CE9AF0" Offset="0.79" />
                                        <GradientStop Color="#E5F6DCAD" Offset="1" />
                                    </LinearGradientBrush>
                                </Rectangle.Stroke>
                            </Rectangle>
                            <Path x:Name="ArcaneTrail" Data="M 0,13 C 32,21 68,19 104,11 C 140,3 178,3 224,11"
                                  Stretch="Fill" Height="12" Margin="9,0,9,6" VerticalAlignment="Bottom"
                                  StrokeThickness="1.15" StrokeStartLineCap="Round" StrokeEndLineCap="Round" IsHitTestVisible="False">
                                <Path.Stroke>
                                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                        <LinearGradientBrush.RelativeTransform><TranslateTransform X="-1" /></LinearGradientBrush.RelativeTransform>
                                        <GradientStop Color="#00C494EF" Offset="0" />
                                        <GradientStop Color="#00C494EF" Offset="0.21" />
                                        <GradientStop Color="#68BC91F0" Offset="0.42" />
                                        <GradientStop Color="#C5FFE3B5" Offset="0.54" />
                                        <GradientStop Color="#82E5A8E9" Offset="0.63" />
                                        <GradientStop Color="#00DEA8E9" Offset="0.8" />
                                        <GradientStop Color="#00DEA8E9" Offset="1" />
                                    </LinearGradientBrush>
                                </Path.Stroke>
                            </Path>
                            <Border x:Name="LaunchPressTint" CornerRadius="10" Background="#350A0411" Opacity="0" IsHitTestVisible="False" />
                            <Grid Margin="12,0,13,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="26" /><ColumnDefinition Width="*" /><ColumnDefinition Width="23" /></Grid.ColumnDefinitions>
                                <Path Data="M 8,0.8 L 15.2,8 L 8,15.2 L 0.8,8 Z M 8,5 L 11,8 L 8,11 L 5,8 Z"
                                      Stroke="#FFE6BE" StrokeThickness="1.15" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <ContentPresenter Grid.Column="1" Margin="4,0" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}" RecognizesAccessKey="True" />
                                <Path x:Name="LaunchArrow" Grid.Column="2" Data="M 1,7 H 13 M 8,2 L 13,7 L 8,12"
                                      Stroke="#FFE1BF" StrokeThickness="1.55" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" Width="15" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path.RenderTransform><TranslateTransform /></Path.RenderTransform>
                                </Path>
                            </Grid>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="LaunchAura" Property="Opacity" Value="1" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsVisible" Value="True" />
                                <Condition Property="IsEnabled" Value="True" />
                                <Condition Property="local:LauncherMotion.ReducedMotion" Value="False" />
                            </MultiTrigger.Conditions>
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard x:Name="LaunchFlow">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ArcaneRim"
                                                         Storyboard.TargetProperty="(Shape.Stroke).(Brush.RelativeTransform).(RotateTransform.Angle)"
                                                         From="25" To="385" Duration="0:0:7.2" RepeatBehavior="Forever" />
                                        <DoubleAnimation Storyboard.TargetName="ArcaneTrail"
                                                         Storyboard.TargetProperty="(Shape.Stroke).(Brush.RelativeTransform).(TranslateTransform.X)"
                                                         From="-1" To="1" Duration="0:0:5.6" RepeatBehavior="Forever" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions><RemoveStoryboard BeginStoryboardName="LaunchFlow" /></MultiTrigger.ExitActions>
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsEnabled" Value="True" />
                                <Condition Property="local:LauncherMotion.ReducedMotion" Value="False" />
                            </MultiTrigger.Conditions>
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard x:Name="LaunchHover">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="LaunchAura" Storyboard.TargetProperty="Opacity"
                                                         From="0.62" To="1" Duration="0:0:0.19" />
                                        <DoubleAnimation Storyboard.TargetName="LaunchArrow"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                         From="0" To="3" Duration="0:0:0.19">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions><RemoveStoryboard BeginStoryboardName="LaunchHover" /></MultiTrigger.ExitActions>
                        </MultiTrigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="LaunchPressTint" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="LaunchSurface" Property="Opacity" Value="0.58" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="MemoryPresetButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="#2B2135" />
        <Setter Property="BorderBrush" Value="#60486E" />
        <Setter Property="Padding" Value="12,5" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Margin" Value="0,0,7,0" />
    </Style>
    <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    </Style>
    <Style x:Key="ChromeButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="30" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style x:Key="CloseChromeButton" TargetType="Button" BasedOn="{StaticResource ChromeButton}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#622A42" />
                <Setter Property="Foreground" Value="#FFE4EC" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="ProgressBar">
        <Setter Property="Height" Value="7" />
        <Setter Property="Background" Value="{StaticResource TrackBrush}" />
        <Setter Property="Foreground" Value="{StaticResource AccentGradient}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid ClipToBounds="True">
                        <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="4" />
                        <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Width="0"
                                Background="{TemplateBinding Foreground}" CornerRadius="4" />
                        <Border x:Name="WaitLight" Visibility="Collapsed" Background="{StaticResource WaitGradient}"
                                CornerRadius="4" Opacity="0.7" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="WaitLight" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsIndeterminate" Value="True" />
                                <Condition Property="IsVisible" Value="True" />
                                <Condition Property="local:LauncherMotion.ReducedMotion" Value="False" />
                            </MultiTrigger.Conditions>
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard x:Name="WaitPulse">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="WaitLight" Storyboard.TargetProperty="Opacity"
                                                         From="0.38" To="0.9" Duration="0:0:1.05" AutoReverse="True"
                                                         RepeatBehavior="Forever">
                                            <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions><RemoveStoryboard BeginStoryboardName="WaitPulse" /></MultiTrigger.ExitActions>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TrackButton" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="11" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton x:Name="PageBefore" Style="{StaticResource TrackButton}" Command="ScrollBar.PageUpCommand" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb x:Name="ScrollThumb" MinHeight="24">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="Grip" Background="#624F70" CornerRadius="4" Margin="2" />
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Grip" Property="Background" Value="#9C7FA9" /></Trigger>
                                                <Trigger Property="IsDragging" Value="True"><Setter TargetName="Grip" Property="Background" Value="#D3A9CF" /></Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton x:Name="PageAfter" Style="{StaticResource TrackButton}" Command="ScrollBar.PageDownCommand" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                            <Setter TargetName="ScrollThumb" Property="MinWidth" Value="24" />
                            <Setter TargetName="ScrollThumb" Property="MinHeight" Value="0" />
                            <Setter TargetName="PageBefore" Property="Command" Value="ScrollBar.PageLeftCommand" />
                            <Setter TargetName="PageAfter" Property="Command" Value="ScrollBar.PageRightCommand" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="Height" Value="11" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="ScrollViewer">
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="PanningMode" Value="VerticalOnly" />
    </Style>

    <ControlTemplate x:Key="InputTemplate" TargetType="Control">
        <Border x:Name="Field" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Field" Property="BorderBrush" Value="#685173" /></Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Field" Property="BorderBrush" Value="{StaticResource FocusBrush}" /></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Field" Property="Opacity" Value="0.48" /></Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style x:Key="InputStyle" TargetType="Control">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Background" Value="{StaticResource InputBrush}" />
        <Setter Property="BorderBrush" Value="#4B3A56" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="11,8" />
        <Setter Property="MinHeight" Value="39" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template" Value="{StaticResource InputTemplate}" />
    </Style>
    <Style TargetType="TextBox" BasedOn="{StaticResource InputStyle}">
        <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
        <Setter Property="SelectionBrush" Value="#9874AA" />
        <Style.Triggers>
            <Trigger Property="AcceptsReturn" Value="True">
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="PasswordBox" BasedOn="{StaticResource InputStyle}">
        <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
        <Setter Property="SelectionBrush" Value="#9874AA" />
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Background" Value="{StaticResource InputBrush}" />
        <Setter Property="BorderBrush" Value="#4B3A56" />
        <Setter Property="MinHeight" Value="39" />
        <Setter Property="MaxDropDownHeight" Value="284" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid x:Name="ComboSurface">
                        <ToggleButton Focusable="False" ClickMode="Press" Cursor="Hand"
                                      Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                      IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="ComboField" Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8">
                                        <Path Data="M 1,2 L 5,6 L 9,2" Stroke="{StaticResource MutedBrush}"
                                              StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,13,0" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ComboField" Property="BorderBrush" Value="#896A95" /></Trigger>
                                        <Trigger Property="IsChecked" Value="True"><Setter TargetName="ComboField" Property="BorderBrush" Value="{StaticResource FocusBrush}" /></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter Margin="12,7,32,7" IsHitTestVisible="False" VerticalAlignment="Center" ClipToBounds="True"
                                          Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />
                        <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                               VerticalOffset="5" AllowsTransparency="True" PopupAnimation="Fade" Focusable="False">
                            <Border Background="#251B2E" BorderBrush="#674E73" BorderThickness="1" CornerRadius="10" Padding="4"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <ScrollViewer>
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="local:LauncherMotion.ReducedMotion" Value="True">
                            <Setter TargetName="PART_Popup" Property="PopupAnimation" Value="None" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ComboSurface" Property="Opacity" Value="0.48" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="ItemSurface" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="#3C2C46" /></Trigger>
                        <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="#513D5B" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ItemSurface" Property="Opacity" Value="0.45" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ChoiceStyle" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="0,5" />
        <Setter Property="Margin" Value="0,4" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}" />
    </Style>
    <Style TargetType="CheckBox" BasedOn="{StaticResource ChoiceStyle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid x:Name="Choice" Background="Transparent">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="27" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border x:Name="Box" Width="17" Height="17" HorizontalAlignment="Left" VerticalAlignment="Center"
                                CornerRadius="5" BorderThickness="1" Background="{StaticResource InputBrush}" BorderBrush="#775D83">
                            <Path x:Name="Tick" Data="M 1,4 L 4,7 L 10,1" Stroke="#2C1A32" StrokeThickness="1.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0" />
                        </Border>
                        <ContentPresenter Grid.Column="1" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource FocusBrush}" /></Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource AccentGradient}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource FocusBrush}" />
                            <Setter TargetName="Tick" Property="Opacity" Value="1" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions><Condition Property="IsChecked" Value="True" /><Condition Property="local:LauncherMotion.ReducedMotion" Value="False" /></MultiTrigger.Conditions>
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard x:Name="TickFade"><Storyboard><DoubleAnimation Storyboard.TargetName="Tick" Storyboard.TargetProperty="Opacity"
                                    From="0.2" To="1" Duration="0:0:0.13" FillBehavior="Stop" /></Storyboard></BeginStoryboard>
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions><RemoveStoryboard BeginStoryboardName="TickFade" /></MultiTrigger.ExitActions>
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Choice" Property="Opacity" Value="0.46" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="RadioButton" BasedOn="{StaticResource ChoiceStyle}">
        <Setter Property="Margin" Value="0,4,24,4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid x:Name="Choice" Background="Transparent">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="27" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid Width="17" Height="17" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <Ellipse x:Name="Ring" Fill="{StaticResource InputBrush}" Stroke="#775D83" StrokeThickness="1" />
                            <Ellipse x:Name="Dot" Width="9" Height="9" Fill="{StaticResource AccentGradient}" Opacity="0" />
                        </Grid>
                        <ContentPresenter Grid.Column="1" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Ring" Property="Stroke" Value="{StaticResource FocusBrush}" /></Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource FocusBrush}" />
                            <Setter TargetName="Dot" Property="Opacity" Value="1" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions><Condition Property="IsChecked" Value="True" /><Condition Property="local:LauncherMotion.ReducedMotion" Value="False" /></MultiTrigger.Conditions>
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard x:Name="DotFade"><Storyboard><DoubleAnimation Storyboard.TargetName="Dot" Storyboard.TargetProperty="Opacity"
                                    From="0.2" To="1" Duration="0:0:0.13" FillBehavior="Stop" /></Storyboard></BeginStoryboard>
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions><RemoveStoryboard BeginStoryboardName="DotFade" /></MultiTrigger.ExitActions>
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Choice" Property="Opacity" Value="0.46" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="MemoryModeChoice" TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}">
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        <Setter Property="MinWidth" Value="88" />
        <Setter Property="MinHeight" Value="33" />
        <Setter Property="Margin" Value="2" />
        <Setter Property="Padding" Value="11,5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="ModeSurface" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="7">
                        <Grid>
                            <Border x:Name="ModeTint" Background="#624768" CornerRadius="6" Opacity="0" IsHitTestVisible="False" />
                            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" RecognizesAccessKey="True" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ModeSurface" Property="Background" Value="#372940" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="ModeSurface" Property="BorderBrush" Value="#94719A" />
                            <Setter TargetName="ModeTint" Property="Opacity" Value="1" />
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True" />
                                <Condition Property="local:LauncherMotion.ReducedMotion" Value="False" />
                            </MultiTrigger.Conditions>
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard x:Name="ModeHighlight">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ModeTint" Storyboard.TargetProperty="Opacity"
                                                         From="0.2" To="1" Duration="0:0:0.17" FillBehavior="Stop" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions><RemoveStoryboard BeginStoryboardName="ModeHighlight" /></MultiTrigger.ExitActions>
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ModeSurface" Property="Opacity" Value="0.48" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="MemoryLimitSlider" TargetType="Slider">
        <Setter Property="Height" Value="38" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid x:Name="SliderSurface" Background="Transparent" ClipToBounds="True">
                        <Border Height="9" Margin="15,0" Background="{StaticResource MemoryReserveBrush}" BorderBrush="#6B5577"
                                BorderThickness="1" CornerRadius="4.5" VerticalAlignment="Center" IsHitTestVisible="False" />
                        <Track x:Name="PART_Track" Orientation="Horizontal" Height="36" VerticalAlignment="Center">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource TrackButton}" Command="Slider.DecreaseLarge">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Grid Background="Transparent">
                                                <Border Height="7" Margin="15,0,-15,0" Background="{StaticResource MemoryGameBrush}"
                                                        CornerRadius="3.5" VerticalAlignment="Center" IsHitTestVisible="False" />
                                            </Grid>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource TrackButton}" Command="Slider.IncreaseLarge" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="30" Height="36" Cursor="Hand">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Grid Background="Transparent">
                                                <Ellipse x:Name="ThumbHalo" Width="28" Height="28" Opacity="0.55" IsHitTestVisible="False">
                                                    <Ellipse.Fill>
                                                        <RadialGradientBrush>
                                                            <GradientStop Color="#E6F6BCDD" Offset="0" />
                                                            <GradientStop Color="#B2D98FC8" Offset="0.52" />
                                                            <GradientStop Color="#00C88FC6" Offset="1" />
                                                        </RadialGradientBrush>
                                                    </Ellipse.Fill>
                                                </Ellipse>
                                                <Border x:Name="ThumbFace" Width="17" Height="17" CornerRadius="8.5"
                                                        Background="{StaticResource MemoryGameBrush}" BorderBrush="#FFEDF7" BorderThickness="1">
                                                    <Ellipse Width="5" Height="5" Fill="#896096" />
                                                </Border>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ThumbHalo" Property="Opacity" Value="0.93" /></Trigger>
                                                <MultiTrigger>
                                                    <MultiTrigger.Conditions>
                                                        <Condition Property="IsMouseOver" Value="True" />
                                                        <Condition Property="local:LauncherMotion.ReducedMotion" Value="False" />
                                                    </MultiTrigger.Conditions>
                                                    <MultiTrigger.EnterActions>
                                                        <BeginStoryboard x:Name="GripGlow">
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="ThumbHalo" Storyboard.TargetProperty="Opacity"
                                                                                 From="0.55" To="0.93" Duration="0:0:0.16" FillBehavior="Stop" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </MultiTrigger.EnterActions>
                                                    <MultiTrigger.ExitActions><RemoveStoryboard BeginStoryboardName="GripGlow" /></MultiTrigger.ExitActions>
                                                </MultiTrigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="ThumbHalo" Property="Opacity" Value="1" />
                                                    <Setter TargetName="ThumbFace" Property="BorderBrush" Value="{StaticResource GoldBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="SliderSurface" Property="Opacity" Value="0.66" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Expander">
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <StackPanel>
                        <ToggleButton x:Name="HeaderSite" Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}"
                                      IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                      FocusVisualStyle="{StaticResource KeyboardFocus}" Cursor="Hand" Foreground="{TemplateBinding Foreground}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="HeaderSurface" Padding="11,8" CornerRadius="8" Background="#2A2034"
                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <Path x:Name="ChevronGlyph" Data="M 2,1 L 7,6 L 2,11" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" RenderTransformOrigin="0.5,0.5"
                                                  HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <Path.RenderTransform><RotateTransform /></Path.RenderTransform>
                                            </Path>
                                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center" RecognizesAccessKey="True" />
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HeaderSurface" Property="Background" Value="{StaticResource HoverBrush}" /></Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="ChevronGlyph" Property="RenderTransform">
                                                <Setter.Value><RotateTransform Angle="90" /></Setter.Value>
                                            </Setter>
                                        </Trigger>
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions><Condition Property="IsChecked" Value="True" /><Condition Property="local:LauncherMotion.ReducedMotion" Value="False" /></MultiTrigger.Conditions>
                                            <MultiTrigger.EnterActions>
                                                <BeginStoryboard x:Name="ExpandChevron"><Storyboard><DoubleAnimation Storyboard.TargetName="ChevronGlyph"
                                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                    From="0" To="90" Duration="0:0:0.16" FillBehavior="Stop" /></Storyboard></BeginStoryboard>
                                            </MultiTrigger.EnterActions>
                                            <MultiTrigger.ExitActions><RemoveStoryboard BeginStoryboardName="ExpandChevron" /></MultiTrigger.ExitActions>
                                        </MultiTrigger>
                                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="HeaderSurface" Property="Opacity" Value="0.46" /></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter x:Name="ExpandSite" ContentSource="Content" Visibility="Collapsed" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True"><Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Background" Value="#30243A" />
        <Setter Property="BorderBrush" Value="#6D547A" />
        <Setter Property="Padding" Value="11,7" />
        <Setter Property="MaxWidth" Value="520" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
